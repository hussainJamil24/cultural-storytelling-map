# Local backend configuration. Never commit a populated .env.
# SetupDemo.bat prompts for the private Gemini key if it is not already set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# New stories must await human review.
NARRIFY_AUTO_APPROVE=false
# Setup generates a private signing key for local sessions.
JWT_SECRET_KEY=
# Optional backend-only video endpoint; unused by the presentation UI.
REPLICATE_API_TOKEN=
